{%- render 'niuviu-konkurs-assets' -%}
{%- assign s = section.settings -%}
<div class="nvk">
  <section class="nvk-sec" id="nvk-produkty">
    <div class="nvk-wrap">
      <header class="nvk-head nvk-head--center">
        <span class="nvk-eyebrow"><b>{{ s.number | escape }}</b>{{ s.label | escape }}</span>
        <h2 class="nvk-h2">{{ s.title_a | escape }} <em>{{ s.title_b | escape }}</em> {{ s.title_c | escape }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
      </header>
      <div class="nvk-prod-grid">
        {%- for i in (1..2) -%}
          {%- liquid
            if i == 1
              assign sr_class = 'nvk-series--braz'
              assign sr_tag = s.s1_tag
              assign sr_name = s.s1_name
              assign sr_sub = s.s1_sub
              assign sr_items = s.s1_items | newline_to_br | split: '<br />'
              assign sr_url = s.s1_url
            else
              assign sr_class = 'nvk-series--styl'
              assign sr_tag = s.s2_tag
              assign sr_name = s.s2_name
              assign sr_sub = s.s2_sub
              assign sr_items = s.s2_items | newline_to_br | split: '<br />'
              assign sr_url = s.s2_url
            endif
          -%}
          {%- if i == 2 -%}
            <figure class="nvk-prod-img">
              <div class="nvk-prod-img__bg" aria-hidden="true"></div>
              {%- if s.image != blank -%}
                {{ s.image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '500, 800, 1300', sizes: '(min-width: 750px) 40vw, 100vw', alt: s.image.alt }}
              {%- else -%}
                <img src="{{ 'niuviu-konkurs-produkty.png' | asset_url }}" alt="" width="1200" height="1180" loading="lazy">
              {%- endif -%}
            </figure>
          {%- endif -%}
          <article class="nvk-series {{ sr_class }}">
            {%- if sr_tag != blank -%}<span class="nvk-pill">{{ sr_tag | escape }}</span>{%- endif -%}
            <h3>{{ sr_name | escape }}</h3>
            {%- if sr_sub != blank -%}<p class="nvk-series__sub">{{ sr_sub | escape }}</p>{%- endif -%}
            <ul>
              {%- for item in sr_items -%}
                {%- assign item_parts = item | split: '|' -%}
                {%- assign item_txt = item_parts[0] | strip -%}
                {%- assign item_url = item_parts[1] | strip | default: sr_url -%}
                {%- if item_txt != blank -%}
                  <li>
                    {%- if item_url != blank -%}
                      <a href="{{ item_url }}"><span>{{ item_txt | escape }}</span>{% render 'niuviu-konkurs-icon', name: 'arrow' %}</a>
                    {%- else -%}
                      <span>{{ item_txt | escape }}</span>{% render 'niuviu-konkurs-icon', name: 'arrow' %}
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </article>
        {%- endfor -%}
      </div>
      {%- if s.note != blank -%}<p class="nvk-prod-note">{{ s.note }}</p>{%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Konkurs – produkty",
  "tag": "div",
  "class": "nvk-shopify-section",
  "settings": [
    { "type": "text", "id": "number", "label": "Numer sekcji", "default": "03" },
    { "type": "text", "id": "label", "label": "Etykieta", "default": "Produkty" },
    { "type": "text", "id": "title_a", "label": "Tytuł – początek", "default": "Wystarczy" },
    { "type": "text", "id": "title_b", "label": "Tytuł – kursywa", "default": "jeden" },
    { "type": "text", "id": "title_c", "label": "Tytuł – koniec", "default": "produkt" },
    { "type": "text", "id": "text", "label": "Opis", "default": "Do konkursu kwalifikuje się każdy produkt z serii Stylizacja lub Brązy." },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie produktów", "info": "Przezroczyste tło (PNG). Puste = obecna wizualizacja produktów." },
    { "type": "header", "content": "Seria 1 (brązowa karta)" },
    { "type": "text", "id": "s1_tag", "label": "Plakietka", "default": "Proteiny" },
    { "type": "text", "id": "s1_name", "label": "Nazwa", "default": "Brązy" },
    { "type": "text", "id": "s1_sub", "label": "Opis", "default": "Do włosów brązowych · zapach musu czekoladowego" },
    { "type": "textarea", "id": "s1_items", "label": "Produkty", "info": "Jeden produkt w linii: nazwa | link do podstrony", "default": "Szampon do brązów | /pages/szampon-do-brazow\nOdżywka do brązów | /pages/odzywka-do-brazow\nSpray termoochronny | /pages/spray-termoochronny" },
    { "type": "url", "id": "s1_url", "label": "Link do serii (opcjonalnie)", "info": "Używany tylko dla produktów bez własnego linku." },
    { "type": "header", "content": "Seria 2 (czerwona karta)" },
    { "type": "text", "id": "s2_tag", "label": "Plakietka", "default": "Inulina" },
    { "type": "text", "id": "s2_name", "label": "Nazwa", "default": "Stylizacja" },
    { "type": "text", "id": "s2_sub", "label": "Opis", "default": "Produkty do stylizacji · zapach białej czekolady" },
    { "type": "textarea", "id": "s2_items", "label": "Produkty", "info": "Jeden produkt w linii: nazwa | link do podstrony", "default": "Krem wygładzający | /pages/krem-wygladzajacy\nSpray teksturyzujący | /pages/spray-teksturyzujacy\nLakier do włosów | /pages/lakier-do-wlosow" },
    { "type": "url", "id": "s2_url", "label": "Link do serii (opcjonalnie)", "info": "Używany tylko dla produktów bez własnego linku." },
    { "type": "header", "content": "Notka" },
    { "type": "inline_richtext", "id": "note", "label": "Notka pod produktami", "default": "Produkty kupisz w sklepach <strong>Biedronka</strong> · zakup musi zostać dokonany w dniach <strong>7–13.12.2026</strong>" }
  ],
  "presets": [{ "name": "Konkurs – produkty" }]
}
{% endschema %}
