{%- render 'niuviu-bf-assets' -%}
{%- assign s = section.settings -%}
<div class="nbf">
  <section class="nbf-sec" id="nbf-kategorie" style="padding-top:70px">
    <div class="nbf-wrap">
      <header class="nbf-head">
        <h2 class="nbf-disp">{{ s.title_a | escape }} <em>{{ s.title_b | escape }}</em></h2>
        {%- if s.link_text != blank -%}
          <a class="nbf-all" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.link_text | escape }} {% render 'niuviu-bf-icon', name: 'arrow' %}</a>
        {%- endif -%}
      </header>
      <div class="nbf-cats{% if section.blocks.size > 2 %} nbf-cats--3{% endif %}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <a class="nbf-cat" href="{{ b.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: b.image.alt, style: b.position }}
            {%- elsif forloop.index == 1 -%}
              <img src="{{ 'niuviu-bf-wlosy.jpg' | asset_url }}" alt="" width="1100" height="1650" loading="lazy" style="object-position:50% 28%">
            {%- elsif forloop.index == 2 -%}
              <img src="{{ 'niuviu-bf-cialo.jpg' | asset_url }}" alt="" width="1100" height="1389" loading="lazy" style="object-position:50% 18%">
            {%- endif -%}
            {%- if b.badge != blank -%}<span class="nbf-chip">{{ b.badge | escape }}</span>{%- endif -%}
            <div class="nbf-cat__bar">
              <div><h3 class="nbf-disp">{{ b.title | escape }}</h3>{%- if b.text != blank -%}<p>{{ b.text | escape }}</p>{%- endif -%}</div>
              <span class="nbf-go">{% render 'niuviu-bf-icon', name: 'arrow' %}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Black Friday – kategorie",
  "tag": "div",
  "class": "nbf-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "title_a", "label": "Tytuł", "default": "Co wrzucasz" },
    { "type": "text", "id": "title_b", "label": "Tytuł – kursywa", "default": "do koszyka?" },
    { "type": "text", "id": "link_text", "label": "Link obok tytułu", "default": "Cały sklep" },
    { "type": "url", "id": "link", "label": "Link obok tytułu – adres" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategoria",
      "settings": [
        { "type": "text", "id": "title", "label": "Nazwa", "default": "Kategoria" },
        { "type": "text", "id": "text", "label": "Opis", "default": "opis kategorii" },
        { "type": "url", "id": "link", "label": "Link", "info": "Np. kolekcja „wlosy” albo „cialo”." },
        { "type": "image_picker", "id": "image", "label": "Zdjęcie", "info": "Puste = zdjęcie domyślne (1. kafelek – włosy, 2. – ciało)." },
        {
          "type": "select", "id": "position", "label": "Kadr zdjęcia", "default": "object-position:50% 25%",
          "options": [
            { "value": "object-position:50% 0%", "label": "Góra" },
            { "value": "object-position:50% 25%", "label": "Wyżej" },
            { "value": "object-position:50% 50%", "label": "Środek" },
            { "value": "object-position:50% 100%", "label": "Dół" }
          ]
        },
        { "type": "text", "id": "badge", "label": "Plakietka", "default": "−35%" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Black Friday – kategorie",
      "blocks": [
        { "type": "category", "settings": { "title": "Włosy", "text": "szampony · maski · odżywki · sera" } },
        { "type": "category", "settings": { "title": "Ciało", "text": "żele · mleczka · kremy · masła" } }
      ]
    }
  ]
}
{% endschema %}
